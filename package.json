    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^21.1.7",
    "sharp": "^0.34.0",
